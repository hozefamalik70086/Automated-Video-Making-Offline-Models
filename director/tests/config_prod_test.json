{
  "comfyui": {
    "url": "http://127.0.0.1:8188",
    "timeout_seconds": 30,
    "render_timeout_seconds": 3600
  },
  "llm": {
    "backend": "none"
  },
  "story": {
    "custom_story_file": "tests/custom_story_prod.txt",
    "genre": "production validation",
    "scenes": 1,
    "seconds_per_scene": 5
  },
  "render": {
    "video_width": 640,
    "video_height": 360,
    "fps": 25,
    "image_width": 1080,
    "image_height": 720,
    "image_steps": 20,
    "video_motion_boost": "continuous visible motion from the first frame to the last: dynamic camera movement, flowing water or wind, drifting clouds, flickering light, moving particles"
  },
  "qc": {
    "enabled": true,
    "max_attempts": 3,
    "duration_tolerance_seconds": 0.6,
    "min_duration_seconds": 4.0,
    "max_black_frames_pct": 15.0,
    "max_frozen_frames_pct": 25.0,
    "min_motion_std": 1.2,
    "min_frames": 40
  },
  "director": {
    "auto_continue": true,
    "manual_review": false,
    "output_dir": "output_prod_test",
    "workflow_template": "workflow_scene_template.json",
    "workflow_knobs": "workflow_knobs.json"
  }
}
