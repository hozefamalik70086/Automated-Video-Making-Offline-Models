{
  "comfyui": {
    "url": "http://127.0.0.1:8899",
    "timeout_seconds": 30,
    "render_timeout_seconds": 300
  },
  "llm": {
    "backend": "none"
  },
  "story": {
    "custom_story_file": "tests/custom_story_chunk.txt",
    "genre": "test",
    "scenes": 3,
    "seconds_per_scene": 2
  },
  "render": {
    "video_width": 1080,
    "video_height": 1920,
    "fps": 30,
    "image_width": 1080,
    "image_height": 1920,
    "image_steps": 10,
    "camera_move": "auto",
    "chunked": true,
    "chunk_seconds": 1.0,
    "chain_frames": true
  },
  "qc": {
    "enabled": true,
    "max_attempts": 3,
    "duration_tolerance_seconds": 0.5,
    "min_duration_seconds": 0.5,
    "max_black_frames_pct": 15.0,
    "max_frozen_frames_pct": 25.0,
    "min_motion_std": 0.0,
    "min_frames": 2
  },
  "director": {
    "auto_continue": true,
    "manual_review": false,
    "output_dir": "tests/output_chunk_test",
    "workflow_template": "workflow_scene_template.json",
    "workflow_knobs": "workflow_knobs.json"
  },
  "audio": {
    "enabled": false,
    "engine": "edge-tts",
    "voice": "en-US-GuyNeural",
    "rate": "+0%"
  },
  "characters": {
    "enabled": false,
    "auto_generate_refs": false,
    "library_dir": "tests/.char_lib_chunk",
    "ref_template": "workflow_scene_template.json",
    "consistency_threshold": 0.85
  }
}
